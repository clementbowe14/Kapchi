NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RELEASE_SHA=replace_me_git_sha
RELEASE_DEPLOYMENT_ID=replace_me_vercel_deployment_id
CRON_SECRET=replace_me_cron_secret_at_least_32_bytes

# Clerk
CLERK_PUBLISHABLE_KEY=replace_me_clerk_publishable_key
CLERK_SECRET_KEY=replace_me_clerk_secret_key
CLERK_JWT_ISSUER=https://example.clerk.accounts.dev
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_AUDIENCE=https://api.example.test
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000
CLERK_WEBHOOK_SECRET=replace_me_clerk_webhook_secret

# Stripe
STRIPE_SECRET_KEY=replace_me_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_me_stripe_webhook_secret
STRIPE_API_VERSION=2026-02-25.clover
KAPCHI_STRIPE_TEST_ACCOUNT_ID=replace_me_stripe_test_account_id
# Production deployments must set both checkout URLs to explicit HTTPS values.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/confirmation
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/cart

# Database
# Supply credential-bearing production URLs through the deployment platform's
# secret manager. These committed examples intentionally contain no credentials.
DATABASE_URL=postgresql://localhost:5432/replace_me_database
DATABASE_DIRECT_URL=postgresql://localhost:5432/replace_me_database

# Per app instance pool settings
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL_MODE=disable

# Deployment target database connection budget
DATABASE_MAX_CONNECTIONS=20
DATABASE_RESERVED_CONNECTIONS=5
DATABASE_MAX_APP_INSTANCES=3

# Redis
# Local placeholder only. Configure production Redis secrets in the deployment
# platform, never in committed files.
REDIS_URL=redis://localhost:6379

# Customer image assets
ASSET_UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ASSET_UPLOAD_MAX_IMAGE_BYTES=5242880
ASSET_UPLOAD_CALLBACK_SECRET_CURRENT=replace_me_current_callback_secret_at_least_32_bytes
ASSET_UPLOAD_CALLBACK_KEY_ID_CURRENT=replace_me_current_key_id
# Optional during a bounded callback-key rotation window.
# ASSET_UPLOAD_CALLBACK_SECRET_PREVIOUS=replace_me_previous_callback_secret_at_least_32_bytes
# ASSET_UPLOAD_CALLBACK_KEY_ID_PREVIOUS=replace_me_previous_key_id
# ASSET_UPLOAD_CALLBACK_SECRET_PREVIOUS_EXPIRES_AT=2026-12-01T00:00:00.000Z
# Legacy local-development compatibility only; production rejects this variable.
# ASSET_UPLOAD_CALLBACK_SECRET=replace_me_legacy_callback_secret
BLOB_READ_WRITE_TOKEN=replace_me_vercel_blob_token
ASSET_PRIVATE_OPEN_TIMEOUT_MS=5000
ASSET_PRIVATE_IDLE_TIMEOUT_MS=15000
ASSET_PRIVATE_TOTAL_TIMEOUT_MS=60000
ASSET_PRIVATE_CROSS_ORIGIN_POLICY=same-site

# Customer messaging gateway (optional until admin messaging is enabled)
MESSAGE_DELIVERY_URL=https://messaging-gateway.example.test/v1/messages
MESSAGE_DELIVERY_TOKEN=replace_me_delivery_token
MESSAGE_WEBHOOK_SECRET=replace_me_webhook_secret
MESSAGE_FROM_EMAIL=support@example.test
MESSAGE_FROM_SMS=+15555550100
MESSAGE_CANARY_DESTINATION=replace_me_non_customer_canary_destination

# Customer order lookup origin. Notifications always link to the fixed /orders path.
ORDER_LOOKUP_BASE_URL=http://localhost:3000
