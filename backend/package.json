{
  "name": "kapchi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate:apply": "tsx src/database/migrate.ts apply",
    "db:migrate:check": "tsx src/database/migrate.ts check",
    "db:migrate:baseline-checksums": "tsx src/database/migrate.ts baseline-checksums",
    "db:migrate:create": "tsx src/database/migrate.ts create",
    "db:migrate:history": "tsx src/database/migrate.ts history",
    "db:migrate:reset": "tsx src/database/migrate.ts reset",
    "db:migrate:status": "tsx src/database/migrate.ts status",
    "db:assert-local": "tsx src/database/assert-local.ts",
    "db:fixtures:init": "tsx src/scripts/init-fixture-database.ts",
    "db:fixtures:bind-admin": "tsx src/scripts/bind-fixture-admin.ts",
    "db:fixtures:unbind-admin": "tsx src/scripts/unbind-fixture-admin.ts",
    "db:seed:local": "tsx src/database/seed.ts",
    "db:seed:verify": "tsx src/scripts/verify-fixture-database.ts",
    "dev": "tsx watch src/server.ts",
    "stripe:catalog:sync:local": "tsx src/scripts/sync-stripe-test-catalog.ts",
    "refunds:reconcile": "tsx src/scripts/reconcile-refunds.ts",
    "shipping:exports:purge": "tsx src/scripts/purge-shipping-exports.ts",
    "inventory:reconcile": "tsx src/scripts/reconcile-fabric-inventory.ts",
    "policies:assert-enforcement-ready": "tsx src/scripts/assert-policy-enforcement-ready.ts",
    "messages:dispatch": "tsx src/scripts/dispatch-messages.ts",
    "operations:health": "tsx src/operations/health.ts",
    "e2e:admin-orders:reset": "tsx src/scripts/reset-admin-order-e2e.ts",
    "start": "node dist/server.js",
    "release:validate": "node ../scripts/validate-launch-record.mjs",
    "release:verify-production": "node ../scripts/verify-production.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/sensible": "^6.0.3",
    "@vercel/blob": "^2.8.2",
    "csv-stringify": "^6.9.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.0.1",
    "file-type": "^21.3.4",
    "joi": "^17.13.9",
    "jose": "^6.0.12",
    "pg": "^8.22.0",
    "redis": "^6.0.0",
    "stripe": "^21.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "zod": "4.6.7"
  }
}
