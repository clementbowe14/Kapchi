{
  "name": "kapchi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate:apply": "tsx src/database/migrate.ts apply",
    "db:migrate:create": "tsx src/database/migrate.ts create",
    "db:migrate:history": "tsx src/database/migrate.ts history",
    "db:migrate:reset": "tsx src/database/migrate.ts reset",
    "db:migrate:status": "tsx src/database/migrate.ts status",
    "db:seed:local": "tsx src/database/seed.ts",
    "dev": "tsx watch src/server.ts",
    "stripe:catalog:sync:local": "tsx src/scripts/sync-stripe-test-catalog.ts",
    "refunds:reconcile": "tsx src/scripts/reconcile-refunds.ts",
    "inventory:reconcile": "tsx src/scripts/reconcile-fabric-inventory.ts",
    "messages:dispatch": "tsx src/scripts/dispatch-messages.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/sensible": "^6.0.3",
    "@vercel/blob": "^2.8.2",
    "dotenv": "^16.5.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.0.1",
    "file-type": "^21.3.4",
    "joi": "^17.13.8",
    "jose": "^6.0.12",
    "pg": "^8.22.0",
    "redis": "^6.0.0",
    "stripe": "^21.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "zod": "4.6.7"
  }
}
