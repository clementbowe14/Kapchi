NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_me_clerk_publishable_key
CLERK_SECRET_KEY=replace_me_clerk_secret_key
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Vercel Blob client upload route
BLOB_READ_WRITE_TOKEN=replace_me_vercel_blob_token
ASSET_UPLOAD_CALLBACK_SECRET_CURRENT=replace_me_current_callback_secret_at_least_32_bytes
ASSET_UPLOAD_CALLBACK_KEY_ID_CURRENT=replace_me_current_key_id
# Optional during a bounded callback-key rotation window.
# ASSET_UPLOAD_CALLBACK_SECRET_PREVIOUS=replace_me_previous_callback_secret_at_least_32_bytes
# ASSET_UPLOAD_CALLBACK_KEY_ID_PREVIOUS=replace_me_previous_key_id
# ASSET_UPLOAD_CALLBACK_SECRET_PREVIOUS_EXPIRES_AT=2026-12-01T00:00:00.000Z
# Legacy local-development compatibility only; production must use the keyed variables above.
# ASSET_UPLOAD_CALLBACK_SECRET=replace_me_legacy_callback_secret
BACKEND_INTERNAL_URL=http://localhost:4000

# Optional: required for full local upload-completed callbacks unless Vercel can
# reach your local Next.js app.
# VERCEL_BLOB_CALLBACK_URL=https://replace-me.ngrok-free.app
