{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapchi.example/schemas/policy-approval-record.json",
  "title": "Kapchi policy approval record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleVersion", "approver", "approvalDate", "scope", "activationDate", "checkoutStatement", "documents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleVersion": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$" },
    "approver": { "type": "string", "minLength": 1, "maxLength": 200 },
    "approvalDate": { "type": "string", "format": "date" },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["owner", "counsel"] } },
    "activationDate": { "type": "string", "format": "date" },
    "checkoutStatement": { "$ref": "#/$defs/versionedDigest" },
    "documents": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/versionedDigest" },
          { "type": "object", "required": ["key"], "properties": { "key": { "enum": ["shipping", "returns", "privacy", "terms"] } } }
        ]
      }
    }
  },
  "$defs": {
    "versionedDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "key": { "type": "string" },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
